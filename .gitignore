# Node deps (broll app) — restore with: cd broll && npm install
node_modules/

# Bundled ffmpeg build (~314 MB) — install ffmpeg locally instead
tools/ffmpeg/

# Person-matting model for reels (~15 MB): rvm_mobilenetv3_fp32.onnx from github.com/PeterL1n/RobustVideoMatting v1.0.0
tools/rvm/

# Raw screen recordings and renders — local only. The reference teardowns are the exception: the skill and
# CLAUDE.md point to them, so the .md travels with the repo while the frames and clips stay local.
videos/*
!videos/reference/
videos/reference/**
!videos/reference/*/
!videos/reference/*/teardown.md

# Python
__pycache__/
*.py[cod]

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Local virtualenv
.venv/

# Remotion local cache
.remotion/

# Reels: the design reference's docs, builder and sheet travel; its frames, footage, mattes and renders stay local
reel-creator/design/frames/
reel-creator/design/public/
reel-creator/design/*.mp4
reel-creator/design/book.json
reel-creator/design/job.json
reel-creator/design/stills.log
